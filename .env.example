# Local development needs none of this - `npm run dev:http` works with the defaults.
# These are for a deployment.

# Port and bind address for the HTTP transport.
PORT=4000
HOST=0.0.0.0

# Public base URL of the deployment. When set, every render result also carries
# `svgUrl`, a stable link to the rendered scene.
# PUBLIC_URL=https://visual-mcp.example.com

# Comma-separated Host headers to accept. Setting this turns on DNS-rebinding
# protection - recommended for anything reachable from a browser.
# ALLOWED_HOSTS=visual-mcp.example.com

# Set to 0 to keep the SVG markup out of the tool results (smaller payloads for
# the model). Only useful together with PUBLIC_URL or an MCP Apps UI host.
# VISUAL_MCP_INLINE_SVG=1
