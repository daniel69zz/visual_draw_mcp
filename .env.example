# Local development needs none of this - `npm run dev:http` works with the defaults.
# These are for a deployment. Copy to `.env` on the VPS and fill in MCP_DOMAIN.

# ---------------------------------------------------------------------------
# Deployment via docker compose (Caddy terminates TLS in front of the server)
# ---------------------------------------------------------------------------

# Public hostname. Without a domain of your own, sslip.io resolves any
# <ip>.sslip.io to that IP, and Let's Encrypt issues a certificate for it:
#   MCP_DOMAIN=203.0.113.45.sslip.io
MCP_DOMAIN=

# Public HTTPS port. Defaults to 500 because port 443 on this VPS is taken by
# another service. Port 80 is NOT configurable: it is the only remaining ACME
# challenge, so it must stay open to the internet or no certificate is issued.
MCP_HTTPS_PORT=500

# ---------------------------------------------------------------------------
# Read directly by the server (docker compose derives the first two from
# MCP_DOMAIN, so you only set these when running without compose)
# ---------------------------------------------------------------------------

# Port and bind address for the HTTP transport.
PORT=4000
HOST=0.0.0.0

# Public base URL of the deployment. When set, every render result also carries
# `svgUrl`, a stable link to the rendered scene.
# PUBLIC_URL=https://visual-mcp.example.com

# Comma-separated Host headers to accept. Setting this turns on DNS-rebinding
# protection - recommended for anything reachable from a browser.
# ALLOWED_HOSTS=visual-mcp.example.com

# Set to 0 to keep the SVG markup out of the tool results (smaller payloads for
# the model). Only useful together with PUBLIC_URL or an MCP Apps UI host.
# VISUAL_MCP_INLINE_SVG=1
