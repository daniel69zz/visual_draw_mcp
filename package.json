{
  "name": "visual-mcp",
  "version": "0.1.0",
  "description": "A Model Context Protocol server that lets an LLM express spatial concepts as structured scenes rendered to clean SVG - instead of ASCII art.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": "./dist/index.js",
    "./renderer": "./dist/renderer/index.js",
    "./scene": "./dist/scene/index.js"
  },
  "bin": {
    "visual-mcp": "./dist/mcp/stdio.js"
  },
  "files": [
    "dist",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:ui": "vite build",
    "build:all": "npm run build && npm run build:ui",
    "dev:stdio": "tsx src/mcp/stdio.ts",
    "dev:http": "tsx watch src/mcp/http.ts",
    "dev:ui": "vite",
    "start": "node dist/mcp/http.js",
    "start:stdio": "node dist/mcp/stdio.js",
    "examples": "tsx scripts/render-examples.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit"
  },
  "keywords": [
    "mcp",
    "model-context-protocol",
    "svg",
    "diagram",
    "visualization",
    "chatgpt",
    "llm"
  ],
  "dependencies": {
    "@modelcontextprotocol/sdk": "^1.30.0",
    "express": "^5.2.1",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/express": "^5.0.6",
    "@types/node": "^26.2.0",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tsx": "^4.23.12",
    "typescript": "^7.0.2",
    "vite": "^8.2.1",
    "vitest": "^4.1.10"
  },
  "engines": {
    "node": ">=20"
  }
}
