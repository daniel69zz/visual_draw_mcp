# TLS automático (Let's Encrypt) para el host de MCP_DOMAIN.
#
# HTTPS se sirve en HTTPS_PORT (500) porque el 443 de este VPS ya está ocupado.
# El desafío TLS-ALPN solo funciona en el 443, así que se desactiva y se valida
# por HTTP-01.
#
# HTTP_PORT (90) es donde Caddy escucha el desafío, porque el 80 también está
# ocupado. OJO: Let's Encrypt SIEMPRE se conecta al puerto 80 - eso no es
# configurable. Para que esto funcione, el servidor que ocupa el 80 debe
# reenviar /.well-known/acme-challenge/* a este puerto 90. Ver README.
{
	http_port {$HTTP_PORT:90}
	https_port {$HTTPS_PORT:500}

	# El puerto 90 sirve EXCLUSIVAMENTE el desafío ACME: sin esto Caddy
	# redirigiría a https://dominio/ (puerto 443), que es de otro servicio.
	auto_https disable_redirects
}

{$MCP_DOMAIN}:{$HTTPS_PORT:500} {
	tls {
		issuer acme {
			disable_tlsalpn_challenge
		}
	}

	encode zstd gzip

	reverse_proxy visual-mcp:4000 {
		# El transporte Streamable HTTP del MCP puede mantener un stream SSE
		# abierto: nunca lo bufferices.
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}
