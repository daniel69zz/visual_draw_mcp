# TLS automático (Let's Encrypt) validando por DNS-01 contra DuckDNS.
#
# Se usa DNS-01 y no HTTP-01 porque los puertos 80 y 443 de este VPS
# pertenecen a otro stack (ucb-sports-hub-nginx) que no se debe modificar.
# DNS-01 no necesita NINGÚN puerto entrante: Caddy crea un registro TXT en
# _acme-challenge.<subdominio>.duckdns.org vía la API de DuckDNS.
#
# Requiere la imagen de ./caddy (Caddy compilado con el módulo duckdns).

{
	https_port {$HTTPS_PORT:500}

	# No hay puerto 80 disponible para redirigir, y no hace falta ninguno.
	auto_https disable_redirects
}

{$MCP_DOMAIN}:{$HTTPS_PORT:500} {
	tls {
		dns duckdns {$DUCKDNS_TOKEN}
		# Resolvers públicos: evita que un DNS local con caché o vista
		# partida haga fallar la comprobación del TXT.
		resolvers 1.1.1.1 8.8.8.8
	}

	encode zstd gzip

	reverse_proxy visual-mcp:4000 {
		# El transporte Streamable HTTP del MCP puede mantener un stream SSE
		# abierto: nunca lo bufferices.
		flush_interval -1
	}

	log {
		output stdout
		format console
	}
}
